{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "soccer-bridge-usa",
  "compatibility_date": "2026-06-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "pages_build_output_dir": "dist",
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
